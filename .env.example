# --- Public site settings ---------------------------------------------
# Full production URL, no trailing slash (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# WhatsApp number in international format, digits only (e.g. 919876543210).
# Leave empty to hide the floating WhatsApp button and WhatsApp CTAs.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact details shown in the footer / contact page (optional)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Social profile URLs (optional - only filled ones are rendered)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Contact form email delivery (server only) -------------------------
# Uses the Resend REST API (https://resend.com). Without these the form
# shows an honest "not configured" message instead of pretending to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="VIRTUAL FIRA <hello@your-verified-domain.com>"
